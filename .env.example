# 화면 캡처(Playwright)용 접속 정보.
# 이 파일을 .env 로 복사해서 값을 채웁니다. .env 는 gitignore 되어 있습니다.
# ⛔ 실제 값을 이 파일(.env.example)에 적지 마세요 — 이건 커밋됩니다.

# 콘솔 주소 (예: https://console.example.com)
PLAYWRIGHT_BASE_URL=

# 로그인 폼의 Domain 필드. 이 필드가 없는 환경이면 비워 둡니다.
TEST_DOMAIN=

# 일반 사용자 계정 — AI Inference 앱 캡처용
TEST_USER=
TEST_PASS=

# 관리자 계정 — Admin AI Inference 앱 캡처용
TEST_USER_ADMIN=
TEST_PASS_ADMIN=

# MFA 를 쓰는 환경에서만. 없으면 비워 둡니다.
MFA_CODE=
